<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <entry name="pollInterval" type="Int">
      <label>Minutes between status checks</label>
      <default>5</default>
      <min>1</min>
      <max>120</max>
    </entry>
    <entry name="notifyOnChange" type="Bool">
      <label>Send a notification when the overall status changes</label>
      <default>true</default>
    </entry>
    <entry name="showOperational" type="Bool">
      <label>List components that are fully operational</label>
      <default>true</default>
    </entry>
    <entry name="showMajorOutageInPanel" type="Bool">
      <label>Show the major outage badge</label>
      <default>true</default>
    </entry>
    <entry name="showPartialOutageInPanel" type="Bool">
      <label>Show the partial outage badge</label>
      <default>true</default>
    </entry>
    <entry name="showDegradedInPanel" type="Bool">
      <label>Show the degraded performance badge</label>
      <default>true</default>
    </entry>
    <entry name="showMaintenanceInPanel" type="Bool">
      <label>Show the under maintenance badge</label>
      <default>true</default>
    </entry>
    <entry name="showOperationalInPanel" type="Bool">
      <label>Show the operational badge</label>
      <default>true</default>
    </entry>
    <entry name="showZeroInPanel" type="Bool">
      <label>Show badges for states with no components</label>
      <default>false</default>
    </entry>
    <entry name="showTotalInPanel" type="Bool">
      <label>Show the total number of components after the badges</label>
      <default>false</default>
    </entry>
    <entry name="collapsedGroups" type="StringList">
      <label>Groups collapsed in the popup</label>
      <default></default>
    </entry>
  </group>
  <group name="Appearance">
    <entry name="showLogo" type="Bool">
      <label>Show a logo in front of the badges in the panel</label>
      <default>false</default>
    </entry>
    <entry name="logoIcon" type="String">
      <label>Icon name or image file for the logo; empty means the widget's own icon</label>
      <default></default>
    </entry>
    <entry name="badgeSpacing" type="Int">
      <label>Gap in pixels between the logo and the badges</label>
      <default>4</default>
    </entry>
    <entry name="badgeStyle" type="String">
      <label>Panel style: square badges, rounded badges, or an icon with a status dot</label>
      <default>square</default>
    </entry>
    <entry name="colorMajorOutage" type="Color">
      <label>major outage colour</label>
      <default>#cb2431</default>
    </entry>
    <entry name="colorPartialOutage" type="Color">
      <label>partial outage colour</label>
      <default>#e36209</default>
    </entry>
    <entry name="colorDegraded" type="Color">
      <label>degraded performance colour</label>
      <default>#dbab09</default>
    </entry>
    <entry name="colorMaintenance" type="Color">
      <label>under maintenance colour</label>
      <default>#0366d6</default>
    </entry>
    <entry name="colorOperational" type="Color">
      <label>operational colour</label>
      <default>#28a745</default>
    </entry>
    <entry name="colorCountBackground" type="Color">
      <label>Count background badge colour</label>
      <default>#2b2f33</default>
    </entry>
  </group>
</kcfg>
